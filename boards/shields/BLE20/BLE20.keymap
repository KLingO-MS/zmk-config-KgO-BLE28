        //     layers = <_A1>;
        // };

        // combo_DOT {
        //     timeout-ms = <60>;
        //     key-positions = <RBR LIT>;
        //     bindings = <&kp DOT>;
        //     layers = <_A1>;
        // };

        // combo_QMARK {
        //     timeout-ms = <60>;
        //     key-positions = <RBP LIT>;
        //     bindings = <&kp QMARK>;
        //     layers = <_A1>;
        // };

        // combo_SEMI {
        //     timeout-ms = <60>;
        //     key-positions = <RTM LIT>;
        //     bindings = <&kp SEMI>;
        //     layers = <_A1>;
        // };

        // combo_COLON {
        //     timeout-ms = <60>;
        //     key-positions = <RTR LIT>;
        //     bindings = <&kp COLON>;
        //     layers = <_A1>;
        // };

        // combo_EXCL {
        //     timeout-ms = <60>;
        //     key-positions = <RTP LIT>;
        //     bindings = <&kp EXCL>;
        //     layers = <_A1>;
        // };

        combo_EXCL {
            timeout-ms = <50>;
            key-positions = <RTI RTM>;
            bindings = <&kp EXCL>;
            require-prior-idle-ms = <150>;
            layers = <_A1>;
        };

        combo_QMARK {
            timeout-ms = <50>;
            key-positions = <RBI RBM>;
            bindings = <&kp QMARK>;
            require-prior-idle-ms = <150>;
            layers = <_A1>;
        };

        combo_LPAR {
            timeout-ms = <40>;
            key-positions = <LBI LIT>;
            bindings = <&kp LPAR>;
            layers = <_A1>;
        };

        combo_RPAR {
            timeout-ms = <50>;
            key-positions = <RIT RBI>;
            bindings = <&kp RPAR>;
            layers = <_A1>;
        };

        combo_LBRC {
            timeout-ms = <50>;
            key-positions = <LBM LIT>;
            bindings = <&kp LBRC>;
            layers = <_A1>;
        };

        combo_RBRC {
            timeout-ms = <50>;
            key-positions = <RIT RBM>;
            bindings = <&kp RBRC>;
            layers = <_A1>;
        };

        combo_LBKT {
            timeout-ms = <50>;
            key-positions = <LBR LIT>;
            bindings = <&kp LBKT>;
            layers = <_A1>;
        };

        combo_RBKT {
            timeout-ms = <50>;
            key-positions = <RBR RIT>;
            bindings = <&kp RBKT>;
            layers = <_A1>;
        };

        combo_LT {
            timeout-ms = <50>;
            key-positions = <LBP LIT>;
            bindings = <&kp LT>;
            layers = <_A1>;
        };

        combo_GT {
            timeout-ms = <50>;
            key-positions = <RBP RIT>;
            bindings = <&kp GT>;
            layers = <_A1>;
        };

        // combo_PSCRN {
        //     timeout-ms = <40>;
        //     key-positions = <LBR LBI>;
        //     bindings = <&kp PSCRN>;
        //     layers = <_BASE _NAV>;
        //     require-prior-idle-ms = <200>;
        // };

        // combo_CP_M {
        //     timeout-ms = <40>;
        //     key-positions = <RTC RMC>;
