        };

        combo_KPMINUS {
            timeout-ms = <50>;
            key-positions = <LBM LBI>;
            bindings = <&kp KP_MINUS>;
            layers = <_NP>;
        };

        combo_KPSTAR {
            timeout-ms = <50>;
