&sl {
    release-after-ms = <1500>;
};

/ {
// ------------------------- MACROS --------------------------------
    macros {
        mlc_ou: macro_ou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&kp O>
                , <&kp U>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";
// ------------------------- LAYER COMBOS --------------------------------
        combo_BOOT {
            timeout-ms = <40>;
            key-positions = <LOT LIT LTP LBP>;
            bindings = <&bootloader>;
        };

        combo_BT_CLR {
            timeout-ms = <40>;
            key-positions = <LTP LTR>;
            bindings = <&bt BT_CLR>;
            layers = <_BT>;
        };

        combo_BT {
            timeout-ms = <50>;
            key-positions = <LOT LIT>;
            bindings = <&mo _BT>;
            require-prior-idle-ms = <200>;
        };

        combo_UNLOCK {
            timeout-ms = <50>;
            key-positions = <ROT RIT>;
            bindings = <&studio_unlock>;
        };

        combo_FUN {
            timeout-ms = <50>;
            key-positions = <LIT RIT>;
            bindings = <&mo _FS>;
            require-prior-idle-ms = <200>;
        };

        combo_NAV {
            timeout-ms = <50>;
            key-positions = <RBI RBM RBR>;
            bindings = <&to _NV>;
            require-prior-idle-ms = <300>;
            layers = <_A1>;
        };

        combo_NUM {
            timeout-ms = <50>;
            key-positions = <LBI LBM LBR>;
            bindings = <&to _NM>;
            require-prior-idle-ms = <300>;
            layers = <_A1>;
        };

        combo_BASER {
            timeout-ms = <50>;
            key-positions = <RBI RBM RBR>;
            bindings = <&to _A1>;
            require-prior-idle-ms = <300>;
            layers = <_NV _NM>;
        };

        combo_BASEL {
            timeout-ms = <50>;
            key-positions = <LBI LBM LBR>;
            bindings = <&to _A1>;
            require-prior-idle-ms = <300>;
            layers = <_NV _NM>;
        };

// ------------------------- VOLUME COMBOS --------------------------------
        // combo_V_UP {
        //     timeout-ms = <40>;
        //     key-positions = <LTI LTM>;
        //     bindings = <&kp C_VOL_UP>;
        //     require-prior-idle-ms = <200>;
        //     layers = <_A1>;
        // };

        // combo_V_DN {
        //     timeout-ms = <40>;
        //     key-positions = <LBM LBI>;
        //     bindings = <&kp C_VOL_DN>;
        //     require-prior-idle-ms = <200>;
        //     layers = <_A1>;
        // };

        combo_MUTE {
            timeout-ms = <50>;
            key-positions = <LTI LTM>;
            bindings = <&kp C_MUTE>;
            layers = <_SM>;
        };

        // combo_ESC {
        //     timeout-ms = <50>;
        //     key-positions = <LTP LTR>;
        //     bindings = <&kp ESC>;
        //     require-prior-idle-ms = <200>;
        // };

        // combo_BSPC {
        //     timeout-ms = <50>;
        //     key-positions = <RBI RBM RBR>;
        //     bindings = <&kp BSPC>;
        //     layers = <_A1>;
        // };



// ------------------------- MODS COMBOS --------------------------------
        combo_CAPS {
            timeout-ms = <50>;
            key-positions = <LTI RTI>;
            bindings = <&caps_word>;
            require-prior-idle-ms = <250>;
            layers = <_A1 _A2>;
        };

        // combo_RALTL {
        //     timeout-ms = <40>;
        //     key-positions = <LMP LTP>;
        //     bindings = <&kp RALT>;
        //     require-prior-idle-ms = <200>;
        //     //layers = <_BASE>;
        // };

        // combo_RALTR {
        //     timeout-ms = <40>;
        //     key-positions = <LMP RTP>;
        //     bindings = <&kp RALT>;
        //     require-prior-idle-ms = <200>;
        //     //layers = <_BASE>;
        // };

// ------------------------- CHARACTER COMBOS --------------------------------
        combo_OU {
            timeout-ms = <300>;
            key-positions = <RTM RTR>;
            bindings = <&mlc_ou>;
            layers = <_A1>;
        };

        // combo_ARE {
        //     timeout-ms = <50>;
        //     key-positions = <LTI LTM LTR>;
        //     bindings = <&mlc_are>;
        //     layers = <_A1>;
        // };

        // combo_YOU {
        //     timeout-ms = <50>;
        //     key-positions = <RBI RBM RBR>;
        //     bindings = <&mm_you>;
        //     layers = <_A1>;
        // };

        // combo_THE {
        //     timeout-ms = <50>;
        //     key-positions = <LBI LBM LBR>;
        //     bindings = <&mm_the>;
        //     layers = <_A1>;
        // };

