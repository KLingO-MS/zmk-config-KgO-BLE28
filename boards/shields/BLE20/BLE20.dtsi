#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>


/ {

    chosen {
//        zmk,kscan = &kscan0;
//        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &default_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <20>;
        rows = <1>;
        map = <
        //     0        1        2        3                            4        5        6        7
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)                      RC(0,13) RC(0,12) RC(0,11) RC(0,10)
        //     8        9        10       11                           12       13       14       15     
            RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)                      RC(0,17) RC(0,16) RC(0,15) RC(0,14)
        //                                16       17         18       19
                                       RC(0,8)  RC(0,9)    RC(0,19) RC(0,18)
        >;
    };

        default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;

                keys  //             w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100   25       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300   25       0     0     0>
            , <&key_physical_attrs 100 100  700   25       0     0     0>
            , <&key_physical_attrs 100 100  800    0       0     0     0>
            , <&key_physical_attrs 100 100  900   25       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  125       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  125       0     0     0>
            , <&key_physical_attrs 100 100  700  125       0     0     0>
            , <&key_physical_attrs 100 100  800  100       0     0     0>
            , <&key_physical_attrs 100 100  900  125       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100  330  225       0     0     0>
            , <&key_physical_attrs 100 100  430  225    1500   430   325>
            , <&key_physical_attrs 100 100  570  225  (-1500)  670   325>
            , <&key_physical_attrs 100 100  670  225       0     0     0>
            ;

    };

};
